# Core
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/autopilot_content_engine
LOG_LEVEL=INFO

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=autopilot-content-engine/1.0
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=Entrepreneur,smallbusiness,marketing,SaaS
REDDIT_FETCH_LIMIT=50

# Threads API (Meta Graph)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_APP_ID=
THREADS_API_VERSION=v1.0
THREADS_FETCH_LIMIT=25
THREADS_SEARCH_TERMS=saas,struggling,help,marketing
THREADS_SCRAPE_RSS_URL=

# Blogger API
BLOGGER_BLOG_ID=
BLOGGER_ACCESS_TOKEN=
BLOGGER_API_KEY=

# Publishing
DRY_RUN=true
REDDIT_TARGET_SUBREDDIT=test
THREADS_HASHTAG_LIMIT=6

# NLP & Clustering
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLUSTER_MIN_SAMPLES=2
CLUSTER_EPS=0.35
NEGATIVE_SENTIMENT_THRESHOLD=-0.15
MIN_PROBLEM_KEYWORD_MATCHES=1

# Scheduling control
MAX_CLUSTERS_PER_RUN=5
MAX_CONTENT_PER_CLUSTER=3
